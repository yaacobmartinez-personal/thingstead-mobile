<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. The session token lives in encrypted storage whose key does not
     survive a restore, so backing anything up only produces a half-broken
     app on the new phone. Nothing here is worth keeping. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
